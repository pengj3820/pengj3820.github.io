---
import Base from '../../layouts/Base.astro';
import { getDevelopers } from '../../lib';
const ds = await getDevelopers();
---
<Base title="Python PDF Guides for Developers" description="Practical, tested Python guides for working with PDFs: PyMuPDF, PaddleOCR, pypdf, pdfplumber and OCRmyPDF, with copy-paste code.">
  <section class="page-head">
    <div class="container">
      <h1>For developers</h1>
      <p>Tested Python code for extracting, editing and OCR-ing PDFs. Copy, paste, run.</p>
    </div>
  </section>
  <div class="container" style="padding: 24px 16px 56px">
    <div class="grid">
      {ds.map((d) => (
        <a class="card" href={`/developers/${d.id}/`}>
          <span class="step-num" aria-hidden="true">&lt;/&gt;</span>
          <div>
            <h3>{d.data.title}</h3>
            <p>{d.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
