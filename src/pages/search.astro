---
import Base from '../layouts/Base.astro';
---
<Base title="Search PDF Guides" description="Search all PDF Fluid guides and lessons." noindex>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <section class="page-head">
    <div class="container">
      <h1>Search</h1>
      <p>Describe your PDF problem in a few words.</p>
    </div>
  </section>
  <div class="container" style="padding: 24px 16px 64px; min-height: 50vh">
    <div id="search"></div>
    <p id="search-empty-hint" style="color:var(--ink-3);margin-top:24px">Try: <a href="?q=compress">compress</a>, <a href="?q=password">password</a>, <a href="?q=word">word</a>, <a href="?q=scan">scan</a>, <a href="?q=font">font</a></p>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, resetStyles: false });
      const q = new URLSearchParams(location.search).get('q');
      if (q) { ui.triggerSearch(q); document.getElementById('search-empty-hint').style.display = 'none'; }
      let t;
      document.addEventListener('input', (e) => {
        if (!e.target.matches('#search input')) return;
        clearTimeout(t);
        const term = e.target.value.trim();
        t = setTimeout(() => {
          if (term.length > 2 && window.gtag) window.gtag('event', 'search', { search_term: term });
        }, 1500);
      });
      if (q && window.gtag) window.gtag('event', 'search', { search_term: q });
    });
  </script>
</Base>
