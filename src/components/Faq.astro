---
interface Props { faqs: { q: string; a: string }[] }
const { faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq">
    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
